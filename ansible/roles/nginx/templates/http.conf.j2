server {
    listen 80;
    listen [::]:80;
    server_name {{ nginx_server_name }};

    location /.well-known/acme-challenge/ {
        root {{ nginx_acme_webroot }};
        allow all;
    }

    location / {
        return 200 'Nginx ready for ACME challenge.\n';
        add_header Content-Type text/plain;
    }
}