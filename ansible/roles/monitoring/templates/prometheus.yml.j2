global:
  scrape_interval: {{ prometheus_scrape_interval }}
  evaluation_interval: {{ prometheus_evaluation_interval }}

alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - "alertmanager:9093"

rule_files:
  - "rules/*.yml"

scrape_configs:
  - job_name: "prometheus"
    static_configs:
      - targets: ["localhost:9090"]

  - job_name: "node"
    ec2_sd_configs:
      - region: us-east-1
        port: 9100
        refresh_interval: 30s
        filters:
          - name: tag:Name
            values:
              - drone-server
              - monitoring
          - name: instance-state-name
            values:
              - running

  - job_name: "nginx"
    ec2_sd_configs:
      - region: us-east-1
        port: 9113
        refresh_interval: 30s
        filters:
          - name: tag:Name
            values:
              - drone-server
              - monitoring
          - name: instance-state-name
            values:
              - running